+fn is_searchable_source_rel(rel: &str, benchmark_active: bool) -> bool {
+    if !is_hidden_rel(rel) {
+        return true;
+    }
+    if !benchmark_active {
+        return false;
+    }
+    let normalized = normalize_rel_path(rel);
+    let segments = normalized.split('/').collect::<Vec<_>>();
+    segments.len() >= 4
+        && segments[0].eq_ignore_ascii_case("raw")
+        && segments[1].eq_ignore_ascii_case("sources")
+        && segments[2].starts_with(".benchmark-")
+        && segments[2].len() > ".benchmark-".len()
+        && segments[3..]
+            .iter()
+            .all(|segment| !segment.is_empty() && !segment.starts_with('.'))
 }
 

+
+fn benchmark_trace_path(run: &BenchmarkRun, session_id: &str) -> Result<PathBuf, String> {
+    let safe_session = session_id.len() <= 240
+        && !session_id.is_empty()
+        && session_id
+            .chars()
+            .all(|character| character.is_ascii_alphanumeric() || "._-".contains(character));
+    if !safe_session {
+        return Err("Benchmark sessionId is not safe for a trace file name".to_string());
+    }
+    Ok(PathBuf::from(&run.project.path)
+        .join(".llm-wiki")
+        .join("benchmark-traces")
+        .join(&run.id)
+        .join(format!("{session_id}.jsonl")))
+}
+
+fn benchmark_trace_sink(path: &Path) -> Result<agent::runtime::AgentEventSink, String> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| "Benchmark trace path has no parent".to_string())?;
+    fs::create_dir_all(parent)
+        .map_err(|error| format!("Failed to create benchmark trace directory: {error}"))?;
+    let file = OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(path)
+        .map_err(|error| format!("Failed to create benchmark trace file: {error}"))?;
+    let file = Arc::new(Mutex::new(file));
+    Ok(Arc::new(move |mut event: agent::events::AgentEvent| {
+        event.redact_for_external_api();
+        let mut value = match serde_json::to_value(event) {
+            Ok(value) => value,
+            Err(_) => return,
+        };
+        if let Some(object) = value.as_object_mut() {
+            let observed_at_unix_ms = SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .map(|duration| duration.as_millis() as u64)
+                .unwrap_or(0);
+            object.insert("observedAtUnixMs".to_string(), json!(observed_at_unix_ms));
+        }
+        if let Ok(mut file) = file.lock() {
+            if serde_json::to_writer(&mut *file, &value).is_ok() {
+                let _ = file.write_all(b"\n");
+                let _ = file.flush();
+            }
+        }
     }))
 }
 

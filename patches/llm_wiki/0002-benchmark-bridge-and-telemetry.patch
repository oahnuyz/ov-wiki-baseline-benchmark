+++ b/src/lib/benchmark-telemetry.ts
@@ -0,0 +1,67 @@
+interface UsagePayload {
+  prompt_tokens?: unknown
+  completion_tokens?: unknown
+}
+
+interface TelemetrySnapshot {
+  inputTokens: number
+  outputTokens: number
+  complete: boolean
+  expectedCalls: number
+  completedCalls: number
+}
+
+let active = false
+let snapshot: TelemetrySnapshot = emptySnapshot()
+
+function emptySnapshot(): TelemetrySnapshot {
+  return {
+    inputTokens: 0,
+    outputTokens: 0,
+    complete: true,
+    expectedCalls: 0,
+    completedCalls: 0,
+  }
+}
+
+export function beginBenchmarkLlmTelemetry(): void {
+  if (active) throw new Error("Benchmark LLM telemetry is already active")
+  active = true
+  snapshot = emptySnapshot()
+}
+
+export function benchmarkLlmCallStarted(streaming: boolean): void {
+  if (!active) return
+  snapshot.expectedCalls += 1
+  if (streaming) snapshot.complete = false
+}
+
+export function isBenchmarkLlmTelemetryActive(): boolean {
+  return active
+}
+
+export function benchmarkLlmCallCompleted(payload: unknown): void {
+  if (!active) return
+  snapshot.completedCalls += 1
+  const usage = payload && typeof payload === "object"
+    ? (payload as { usage?: UsagePayload }).usage
+    : undefined
+  const input = usage?.prompt_tokens
+  const output = usage?.completion_tokens
+  if (
+    typeof input !== "number" || !Number.isInteger(input) || input < 0 ||
+    typeof output !== "number" || !Number.isInteger(output) || output < 0
+  ) {
+    snapshot.complete = false
+    return
+  }
+  snapshot.inputTokens += input
+  snapshot.outputTokens += output
+}
+
+export function finishBenchmarkLlmTelemetry(): TelemetrySnapshot {
+  if (!active) throw new Error("Benchmark LLM telemetry is not active")
+  active = false
+  if (snapshot.expectedCalls !== snapshot.completedCalls) snapshot.complete = false
+  return { ...snapshot }
+}

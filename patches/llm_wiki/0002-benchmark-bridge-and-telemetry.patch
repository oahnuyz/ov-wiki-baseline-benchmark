+
+const MODEL = "doubao-seed-2-0-lite-260428"
+const EMBEDDING_MODEL = "doubao-embedding-vision-251215"
+const ARK_BASE = "https://ark.cn-beijing.volces.com/api/v3"
+const DEFAULT_MAX_CONTEXT_SIZE = 204800
+const GENERAL_INDEX = `# Wiki Index
+
+## Entities
+
+## Concepts
+
+## Sources
+
+## Queries
+
+## Comparisons
+
+## Synthesis
+`
+const GENERAL_OVERVIEW = `---
+type: overview
+title: Project Overview
+tags: []
+related: []
+---
+
+# Overview
+
+<!-- Provide a high-level summary of what this wiki covers and its current state. Update regularly as understanding deepens. -->
+`
+const GENERAL_LOG = "# Research Log\n"
+const GENERAL_WIKI_DIRS = [
+  "entities",
+  "concepts",
+  "sources",
+  "queries",
+  "comparisons",
+  "synthesis",
+  "media",
+]
+const GENERAL_STRUCTURAL_FILES = new Set([
+  "wiki/index.md",
+  "wiki/overview.md",
+  "wiki/log.md",
+])
+
+interface BridgeRequest {
+  requestId: string
+  operation: "create" | "ingest" | "delete"
+  payload: Record<string, unknown>
+}
+
+interface RustUsage {
+  inputTokens: number
+  outputTokens: number
+  embeddingTokens: number
+  complete: boolean
+}
+
+interface BenchmarkBootstrapConfig {
+  enabled: boolean

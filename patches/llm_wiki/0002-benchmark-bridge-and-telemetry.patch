+  if (!config.enabled) return null
+  const projectPath = normalizePath(config.projectPath)
+  if (!projectPath.startsWith("/") || !config.arkApiKey.trim()) {
+    throw new Error("Benchmark bootstrap configuration is incomplete")
+  }
+
+  let project
+  try {
+    project = await openProject(projectPath)
+  } catch (openError) {
+    await createDirectory(projectPath)
+    const entries = await listDirectory(projectPath, { includeHidden: true, maxDepth: 1 })
+    if (entries.length > 0) {
+      throw new Error(
+        `Benchmark project is non-empty but invalid: ${String(openError)}`,
+      )
+    }
+    await restoreGeneralScaffold(projectPath)
+    project = await openProject(projectPath)
+  }

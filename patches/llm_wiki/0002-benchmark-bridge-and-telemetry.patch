+  }
+  const mineru = { ...state.mineruConfig, enabled: false }
+  const search = {
+    ...state.searchApiConfig,
+    provider: "none" as const,
+    anyTxt: { ...state.searchApiConfig.anyTxt, enabled: false },
+  }
+  const taskRouting = { chatPresetId: null, ingestPresetId: null }
+  const projectOverride = { enabled: false, presetId: null, model: "" }
+  const sourceWatch = {
+    ...state.sourceWatchConfig,
+    persistExtractedMarkdown: false,
+    ingestConcurrency: 1,
+  }
+
+  state.setLlmConfig(llm)
+  state.setEmbeddingConfig(embedding)
+  state.setMultimodalConfig(multimodal)
+  state.setMineruConfig(mineru)
+  state.setSearchApiConfig(search)
+  state.setOutputLanguage("auto")
+  state.setSourceWatchConfig(sourceWatch)
+  state.setTaskModelRouting(taskRouting)

+use std::collections::HashMap;
+use std::sync::mpsc::{self, SyncSender};
+use std::sync::{Mutex, OnceLock};
+use std::time::Duration;
+
+use serde::Serialize;
+use serde_json::{json, Value};
+use tauri::{AppHandle, Emitter};
+use uuid::Uuid;
+
+const HEADLESS_ENV: &str = "LLM_WIKI_BENCHMARK_HEADLESS";
+const PROJECT_PATH_ENV: &str = "LLM_WIKI_BENCHMARK_PROJECT_PATH";
+const ARK_API_KEY_ENV: &str = "ARK_API_KEY";
+const BRIDGE_TOKEN_ENV: &str = "LLM_WIKI_API_TOKEN";
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct BootstrapConfig {
+    enabled: bool,
+    project_path: String,
+    ark_api_key: String,
+}
+
+#[derive(Default)]
+struct FrontendReadiness {
+    listener_ready: bool,
+    project_path: Option<String>,
+}
+
+#[derive(Debug, Clone, Default, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct UsageSnapshot {
+    pub input_tokens: u64,
+    pub output_tokens: u64,
+    pub embedding_tokens: u64,
+    pub agent_input_tokens: u64,
+    pub agent_output_tokens: u64,
+    pub search_input_tokens: u64,
+    pub search_output_tokens: u64,
+    pub complete: bool,
+    pub expected_calls: u64,
+    pub completed_calls: u64,
+}
+
+#[derive(Default)]
+struct UsageState {
+    active: bool,
+    stage: String,
+    snapshot: UsageSnapshot,
+}
+
+static USAGE: OnceLock<Mutex<UsageState>> = OnceLock::new();
+static PENDING: OnceLock<Mutex<HashMap<String, SyncSender<Result<Value, String>>>>> =
+    OnceLock::new();
+static FRONTEND_READINESS: OnceLock<Mutex<FrontendReadiness>> = OnceLock::new();
+
+fn readiness() -> &'static Mutex<FrontendReadiness> {
+    FRONTEND_READINESS.get_or_init(|| Mutex::new(FrontendReadiness::default()))
+}
+
+fn normalized_path(value: &str) -> String {
+    value.trim().replace('\\', "/").trim_end_matches('/').to_string()
+}
+
+fn required_env(name: &str) -> Result<String, String> {
+    std::env::var(name)
+        .ok()
+        .map(|value| value.trim().to_string())
+        .filter(|value| !value.is_empty())
+        .ok_or_else(|| format!("{name} is required in benchmark headless mode"))
+}
+
+pub fn headless_enabled() -> bool {
+    std::env::var(HEADLESS_ENV)
+        .ok()
+        .map(|value| matches!(value.trim().to_ascii_lowercase().as_str(), "1" | "true" | "yes"))
+        .unwrap_or(false)
+}
+
+pub fn bootstrap_config() -> Result<BootstrapConfig, String> {
+    if !headless_enabled() {
+        return Ok(BootstrapConfig {
+            enabled: false,
+            project_path: String::new(),
+            ark_api_key: String::new(),
+        });
+    }
+    let project_path = normalized_path(&required_env(PROJECT_PATH_ENV)?);
+    let path = std::path::Path::new(&project_path);
+    if !path.is_absolute() || path.parent().is_none() || project_path == "/" {
+        return Err(format!("{PROJECT_PATH_ENV} must be a safe absolute project path"));
+    }
+    let ark_api_key = required_env(ARK_API_KEY_ENV)?;
+    required_env(BRIDGE_TOKEN_ENV)?;
+    Ok(BootstrapConfig {
+        enabled: true,
+        project_path,
+        ark_api_key,
+    })
+}
+
+pub fn mark_listener_ready() -> Result<(), String> {
+    let mut state = readiness()
+        .lock()
+        .map_err(|_| "Benchmark readiness lock is unavailable".to_string())?;
+    state.listener_ready = true;
+    Ok(())
+}
+
+pub fn mark_project_ready(project_path: &str) -> Result<(), String> {
+    let expected = bootstrap_config()?;
+    if !expected.enabled {
+        return Err("Benchmark headless mode is not enabled".to_string());
+    }
+    let project_path = normalized_path(project_path);
+    if project_path != expected.project_path {
+        return Err("Benchmark frontend opened a different project path".to_string());
+    }
+    let root = std::path::Path::new(&project_path);
+    if !root.join("schema.md").is_file() || !root.join("wiki").is_dir() {
+        return Err("Benchmark project scaffold is incomplete".to_string());
+    }
+    let mut state = readiness()
+        .lock()
+        .map_err(|_| "Benchmark readiness lock is unavailable".to_string())?;
+    state.project_path = Some(project_path);
+    Ok(())
+}
+
+pub fn frontend_ready_for(project_path: &str) -> bool {
+    let expected = normalized_path(project_path);
+    readiness()
+        .lock()
+        .map(|state| {
+            state.listener_ready
+                && state.project_path.as_deref() == Some(expected.as_str())
+        })
+        .unwrap_or(false)
+}
+
+pub fn ready_project_path() -> Option<String> {
+    readiness().lock().ok().and_then(|state| {
+        if state.listener_ready {
+            state.project_path.clone()
+        } else {
+            None
+        }
+    })
+}
+
+fn usage() -> &'static Mutex<UsageState> {
+    USAGE.get_or_init(|| Mutex::new(UsageState::default()))
+}
+
+pub fn begin(stage: &str) -> Result<(), String> {
+    let mut state = usage()
+        .lock()
+        .map_err(|_| "Benchmark telemetry lock is unavailable".to_string())?;
+    if state.active {
+        return Err("Another benchmark telemetry stage is active".to_string());
+    }
+    state.active = true;
+    state.stage = stage.to_string();
+    state.snapshot = UsageSnapshot {
+        complete: true,
+        ..UsageSnapshot::default()
+    };
+    Ok(())
+}
+
+pub fn call_started() {
+    if let Ok(mut state) = usage().lock() {
+        if state.active {
+            state.snapshot.expected_calls += 1;
+        }
+    }
+}
+
+pub fn is_active() -> bool {
+    usage().lock().map(|state| state.active).unwrap_or(false)
+}
+
+pub fn agent_call_completed(prompt_tokens: u64, completion_tokens: u64) {
+    if let Ok(mut state) = usage().lock() {
+        if state.active {
+            state.snapshot.completed_calls += 1;
+            state.snapshot.input_tokens += prompt_tokens;
+            state.snapshot.output_tokens += completion_tokens;
+            state.snapshot.agent_input_tokens += prompt_tokens;
+            state.snapshot.agent_output_tokens += completion_tokens;
+        }
+    }
+}
+
+pub fn embedding_call_completed(prompt_tokens: Option<u64>) {
+    if let Ok(mut state) = usage().lock() {
+        if !state.active {
+            return;
+        }
+        state.snapshot.completed_calls += 1;
+        match prompt_tokens {
+            Some(tokens) => state.snapshot.embedding_tokens += tokens,
+            None => state.snapshot.complete = false,
+        }
+    }
+}
+
+pub fn mark_incomplete() {
+    if let Ok(mut state) = usage().lock() {
+        if state.active {
+            state.snapshot.complete = false;
+        }
+    }
+}
+
+pub fn finish(stage: &str) -> Result<UsageSnapshot, String> {
+    let mut state = usage()
+        .lock()
+        .map_err(|_| "Benchmark telemetry lock is unavailable".to_string())?;
+    if !state.active || state.stage != stage {
+        return Err(format!("Benchmark telemetry stage mismatch: expected {stage}"));
+    }
+    state.active = false;
+    if state.snapshot.expected_calls != state.snapshot.completed_calls {
+        state.snapshot.complete = false;
+    }
+    Ok(state.snapshot.clone())
+}
+
+pub fn dispatch_frontend(
+    app: &AppHandle,
+    operation: &str,
+    payload: Value,
+    timeout: Duration,
+) -> Result<Value, String> {
+    let request_id = Uuid::new_v4().to_string();
+    let (sender, receiver) = mpsc::sync_channel(1);
+    PENDING
+        .get_or_init(|| Mutex::new(HashMap::new()))
+        .lock()
+        .map_err(|_| "Benchmark bridge lock is unavailable".to_string())?
+        .insert(request_id.clone(), sender);
+    if let Err(error) = app.emit(
+        "llm-wiki://benchmark-request",
+        json!({
+            "requestId": request_id.clone(),
+            "operation": operation,
+            "payload": payload,
+        }),
+    ) {
+        if let Ok(mut pending) = PENDING.get().unwrap().lock() {
+            pending.remove(&request_id);
+        }
+        return Err(format!("Failed to dispatch benchmark request: {error}"));
+    }
+    match receiver.recv_timeout(timeout) {
+        Ok(result) => result,
+        Err(_) => {
+            if let Some(pending) = PENDING.get() {
+                if let Ok(mut pending) = pending.lock() {
+                    pending.remove(&request_id);
+                }
+            }
+            Err(format!(
+                "Benchmark frontend operation '{operation}' timed out"
+            ))
+        }
+    }
+}
+
+#[tauri::command]
+pub fn benchmark_bridge_complete(
+    request_id: String,
+    result: Option<Value>,
+    error: Option<String>,
+) -> Result<(), String> {
+    let sender = PENDING
+        .get_or_init(|| Mutex::new(HashMap::new()))
+        .lock()
+        .map_err(|_| "Benchmark bridge lock is unavailable".to_string())?
+        .remove(&request_id)
+        .ok_or_else(|| "Unknown or expired benchmark request".to_string())?;
+    let response = match error.filter(|value| !value.trim().is_empty()) {
+        Some(message) => Err(message),
+        None => Ok(result.unwrap_or(Value::Null)),
+    };
+    sender
+        .send(response)
+        .map_err(|_| "Benchmark request receiver disconnected".to_string())
+}
+
+#[tauri::command]
+pub fn benchmark_telemetry_begin(stage: String) -> Result<(), String> {
+    begin(&stage)
+}
+
+#[tauri::command]
+pub fn benchmark_telemetry_finish(stage: String) -> Result<UsageSnapshot, String> {
+    finish(&stage)
+}
+
+#[tauri::command]
+pub fn benchmark_bootstrap_config() -> Result<BootstrapConfig, String> {
+    bootstrap_config()
+}
+
+#[tauri::command]
+pub fn benchmark_bridge_listener_ready() -> Result<(), String> {
+    mark_listener_ready()
+}
+
+#[tauri::command]
+pub fn benchmark_project_ready(project_path: String) -> Result<(), String> {
+    mark_project_ready(&project_path)?;
+    crate::clip_server::set_current_project_path(&project_path)
+}

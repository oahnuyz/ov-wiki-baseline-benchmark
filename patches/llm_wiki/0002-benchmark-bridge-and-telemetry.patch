+}
+
+function requireActiveProject(projectPath: unknown) {
+  const project = useWikiStore.getState().project
+  if (!project) throw new Error("Open the dedicated benchmark project first")
+  if (normalizePath(project.path) !== normalizePath(String(projectPath ?? ""))) {
+    throw new Error("Benchmark projectPath does not match the active project")
+  }
+  return project
+}
+
+function validateManifest(config: unknown): void {
+  const value = config as Record<string, any>
+  if (
+    value?.llmWiki?.version !== "0.6.11" ||
+    value?.llmWiki?.commit !== "e8082119649e6a8e1cf85eaf289adcabfdf39d4e" ||
+    value?.llmWiki?.mode !== "standard" ||
+    value?.llmWiki?.retrievalMode !== "standard" ||
+    value?.llmWiki?.topK?.source !== "official_default" ||
+    value?.llmWiki?.topK?.resolvedValue !== 5 ||
+    value?.llmWiki?.maxContextSize?.source !== "official_default" ||
+    value?.llmWiki?.maxContextSize?.resolvedValue !== DEFAULT_MAX_CONTEXT_SIZE ||
+    value?.llmWiki?.vectorRetrieval !== true ||
+    value?.llmWiki?.imageCaptioning !== true ||
+    value?.llmWiki?.pdfParser !== "builtin" ||
+    value?.llmWiki?.reviewSweepIncludedInIngest !== true ||
+    value?.llmWiki?.projectTemplate !== "general" ||
+    value?.llmWiki?.outputLanguage !== "auto" ||
+    value?.llmWiki?.chunking !== "official_default" ||
+    value?.llmWiki?.persistExtractedMarkdown !== false ||
+    value?.model?.name !== MODEL ||
+    value?.model?.provider !== "volcengine" ||
+    value?.model?.baseUrl !== ARK_BASE ||
+    value?.model?.temperature !== 0 ||
+    value?.model?.thinking !== "disabled" ||
+    value?.embedding?.name !== EMBEDDING_MODEL ||
+    value?.embedding?.provider !== "volcengine" ||
+    value?.embedding?.baseUrl !== ARK_BASE ||
+    value?.embedding?.dimensions !== 1024 ||
+    value?.embedding?.input !== "multimodal"
+  ) {
+    throw new Error("Benchmark manifest does not match the fixed experiment configuration")
+  }
+}
+
+function flattenFiles(nodes: Awaited<ReturnType<typeof listDirectory>>): string[] {
+  const files: string[] = []
+  const visit = (items: typeof nodes) => {
+    for (const item of items) {
+      if (item.is_dir) visit(item.children ?? [])
+      else files.push(normalizePath(item.path))
+    }
+  }
+  visit(nodes)
+  return files
+}
+
+async function sha256Text(content: string): Promise<string> {
+  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(content))
+  return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("")
+}
+
+async function restoreGeneralScaffold(projectPath: string) {
+  const pp = normalizePath(projectPath)
+  const wikiPath = `${pp}/wiki`
+  const existing = await listDirectory(wikiPath).catch(() => [])
+  const unexpected = flattenFiles(existing).filter((path) => {
+    const relative = path.startsWith(`${pp}/`) ? path.slice(pp.length + 1) : path
+    return !GENERAL_STRUCTURAL_FILES.has(relative)
+  })
+  if (unexpected.length > 0) {
+    throw new Error(
+      `Dedicated benchmark project contains prior Wiki data: ${unexpected[0]}`,
+    )
+  }
+
+  const template = getTemplate("general")
+  const files: Record<string, string> = {
+    "purpose.md": template.purpose,
+    "schema.md": template.schema,
+    "wiki/index.md": GENERAL_INDEX,
+    "wiki/overview.md": GENERAL_OVERVIEW,
+    "wiki/log.md": GENERAL_LOG,
+  }
+  await createDirectory(wikiPath)
+  await Promise.all(GENERAL_WIKI_DIRS.map((dir) => createDirectory(`${wikiPath}/${dir}`)))
+  await Promise.all(
+    Object.entries(files).map(([relative, content]) => writeFile(`${pp}/${relative}`, content)),
+  )
+  const hashes = Object.fromEntries(
+    await Promise.all(
+      Object.entries(files).map(async ([relative, content]) => [relative, await sha256Text(content)]),
+    ),
+  )
+  return {
+    template: "general",
+    outputLanguage: "auto",
+    chunking: "official_default",
+    persistExtractedMarkdown: false,
+    fileSha256: hashes,
+  }

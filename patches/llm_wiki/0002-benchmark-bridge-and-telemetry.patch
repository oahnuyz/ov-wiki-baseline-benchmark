+fn benchmark_runs() -> &'static Mutex<HashMap<String, BenchmarkRun>> {
+    BENCHMARK_RUNS.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+fn benchmark_run(run_id: &str) -> Result<BenchmarkRun, ApiResponse> {
+    benchmark_runs()
+        .lock()
+        .map_err(|_| err(500, "Benchmark run registry is unavailable"))?
+        .get(run_id)
+        .cloned()
+        .ok_or_else(|| err(404, format!("Unknown benchmark run: {run_id}")))
+}
+
+fn handle_benchmark_ready() -> ApiResponse {
+    match benchmark::ready_project_path() {
+        Some(project_path) => ok(json!({
+            "ready": true,
+            "projectPath": project_path,
+        })),
+        None => err(503, "Benchmark frontend is still starting"),
+    }
+}
+
+fn handle_benchmark_create(app: &AppHandle, body: &str) -> ApiResponse {
+    let mut value: Value = match serde_json::from_str(body) {
+        Ok(value) => value,
+        Err(error) => return err(400, format!("Invalid JSON: {error}")),
+    };
+    let corpus_id = value
+        .get("corpusId")
+        .and_then(Value::as_str)
+        .unwrap_or("")
+        .trim()
+        .to_string();
+    let project_path = value
+        .get("projectPath")
+        .and_then(Value::as_str)
+        .unwrap_or("")
+        .trim()
+        .to_string();
+    if corpus_id.is_empty() || project_path.is_empty() || value.get("config").is_none() {
+        return err(400, "corpusId, projectPath, and config are required");
+    }
+    if !benchmark::frontend_ready_for(&project_path) {
+        return err(503, "Benchmark frontend is not ready for this project");
+    }
+    let project = match resolve_project(app, &project_path) {
+        Ok(project) => project,
+        Err(error) => return err(404, error),
+    };
+    if !project.current || !project_path_matches(&project.path, &project_path) {
+        return err(409, "The dedicated benchmark project must already be open");
+    }
+    let duplicate = benchmark_runs()
+        .lock()
+        .map(|runs| {
+            runs.values()
+                .any(|run| project_path_matches(&run.project.path, &project.path))
+        })
+        .unwrap_or(true);
+    if duplicate {
+        return err(409, "An active benchmark run already owns this project");
+    }
+
+    let run_id = Uuid::new_v4().to_string();
+    value["runId"] = Value::String(run_id.clone());
+    let frontend = match benchmark::dispatch_frontend(
+        app,
+        "create",
+        value,
+        Duration::from_secs(30),
+    ) {
+        Ok(result) => result,
+        Err(error) => return err(500, error),
+    };
+    if frontend
+        .get("resolvedMaxContextSize")
+        .and_then(Value::as_u64)
+        != Some(204_800)
+    {
+        return err(500, "Frontend did not confirm maxContextSize=204800");
+    }
+    let scaffold = match frontend.get("projectScaffold") {
+        Some(value)
+            if value.get("template").and_then(Value::as_str) == Some("general")
+                && value.get("outputLanguage").and_then(Value::as_str) == Some("auto")
+                && value.get("chunking").and_then(Value::as_str)
+                    == Some("official_default")
+                && value
+                    .get("persistExtractedMarkdown")
+                    .and_then(Value::as_bool)
+                    == Some(false)
+                && value
+                    .get("fileSha256")
+                    .and_then(Value::as_object)
+                    .is_some_and(|hashes| {
+                        [
+                            "purpose.md",
+                            "schema.md",
+                            "wiki/index.md",
+                            "wiki/overview.md",
+                            "wiki/log.md",
+                        ]
+                        .iter()
+                        .all(|path| {
+                            hashes
+                                .get(*path)
+                                .and_then(Value::as_str)
+                                .is_some_and(|hash| {
+                                    hash.len() == 64
+                                        && hash.chars().all(|ch| ch.is_ascii_hexdigit())
+                                })
+                        })
+                    }) => value.clone(),
+        _ => return err(500, "Frontend did not confirm the General project scaffold"),
+    };
+    let run = BenchmarkRun {
+        id: run_id.clone(),
+        corpus_id,
+        project,
+    };
+    if let Ok(mut runs) = benchmark_runs().lock() {
+        runs.insert(run_id.clone(), run);
+    } else {
+        return err(500, "Benchmark run registry is unavailable");
+    }
+    ok(json!({
+        "runId": run_id,
+        "resolvedMaxContextSize": 204800,
+        "projectScaffold": scaffold,
+    }))
+}
+
+fn handle_benchmark_ingest(app: &AppHandle, run_id: &str, body: &str) -> ApiResponse {
+    let run = match benchmark_run(run_id) {
+        Ok(run) => run,
+        Err(response) => return response,
+    };
+    let mut value: Value = match serde_json::from_str(body) {
+        Ok(value) => value,
+        Err(error) => return err(400, format!("Invalid JSON: {error}")),
+    };
+    let documents = value.get("documents").and_then(Value::as_array);
+    if documents.map(Vec::is_empty).unwrap_or(true)
+        || documents
+            .unwrap()
+            .iter()
+            .any(|item| item.as_str().map(str::trim).unwrap_or("").is_empty())
+    {
+        return err(400, "documents must be a non-empty array of paths");
+    }
+    value["runId"] = Value::String(run.id.clone());
+    value["corpusId"] = Value::String(run.corpus_id.clone());
+    value["projectPath"] = Value::String(run.project.path.clone());
+    match benchmark::dispatch_frontend(
+        app,
+        "ingest",
+        value,
+        Duration::from_secs(36 * 60 * 60),
+    ) {
+        Ok(result) => ok(result),
+        Err(error) => err(502, error),
+    }
+}
+
+fn validate_benchmark_qa(value: &Value) -> Result<(), String> {
+    let tools = value.get("tools").and_then(Value::as_object);
+    let valid_tools = tools
+        .map(|tools| {
+            tools.get("wiki").and_then(Value::as_bool) == Some(true)
+                && tools.get("web").and_then(Value::as_bool) == Some(false)
+                && tools.get("anytxt").and_then(Value::as_bool) == Some(false)
+        })
+        .unwrap_or(false);
+    let empty_history = value
+        .get("history")
+        .and_then(Value::as_array)
+        .map(Vec::is_empty)
+        == Some(true);
+    let empty_skills = value
+        .get("skills")
+        .and_then(Value::as_array)
+        .map(Vec::is_empty)
+        == Some(true);
+    if value.get("message").and_then(Value::as_str).map(str::trim) == Some("")
+        || value.get("message").and_then(Value::as_str).is_none()
+        || value.get("sessionId").and_then(Value::as_str).map(str::trim) == Some("")
+        || value.get("sessionId").and_then(Value::as_str).is_none()
+        || value.get("mode").and_then(Value::as_str) != Some("standard")
+        || value.get("retrievalMode").and_then(Value::as_str) != Some("standard")
+        || value.get("topK").is_some()
+        || !valid_tools
+        || !empty_history
+        || value.get("historyExplicit").and_then(Value::as_bool) != Some(true)
+        || !empty_skills
+        || value.get("skillMode").and_then(Value::as_str) != Some("explicit")
+        || value.get("persistSession").and_then(Value::as_bool) != Some(false)
+    {
+        return Err("QA request violates the fixed benchmark isolation contract".to_string());
+    }
+    Ok(())
+}
+
+fn handle_benchmark_qa(app: &AppHandle, run_id: &str, body: &str) -> ApiResponse {
+    let run = match benchmark_run(run_id) {
+        Ok(run) => run,
+        Err(response) => return response,
+    };
+    let value: Value = match serde_json::from_str(body) {
+        Ok(value) => value,
+        Err(error) => return err(400, format!("Invalid JSON: {error}")),
+    };
+    if let Err(error) = validate_benchmark_qa(&value) {
+        return err(400, error);
+    }
+    let session_id = value
+        .get("sessionId")
+        .and_then(Value::as_str)
+        .unwrap_or("")
+        .to_string();
+    let stage = format!("qa:{}:{session_id}", run.id);
+    if let Err(error) = benchmark::begin(&stage) {
+        return err(409, error);
+    }
+    let started = Instant::now();
+    let response = handle_chat(app, &run.project.id, body);
+    let duration = started.elapsed().as_secs_f64();
+    let usage = match benchmark::finish(&stage) {
+        Ok(usage) => usage,
+        Err(error) => return err(500, error),
+    };
+    if response.status != 200 {
+        return response;
+    }
+    if !usage.complete {
+        return err(502, "Provider usage telemetry was incomplete during QA");
+    }
+    let answer = response
+        .body
+        .pointer("/message/content")
+        .and_then(Value::as_str)
+        .unwrap_or("");
+    if answer.trim().is_empty() {
+        return err(502, "Agent returned an empty answer");
+    }
+    ok(json!({
+        "status": "completed",
+        "answer": answer,
+        "sessionId": response.body.get("sessionId").cloned().unwrap_or(Value::Null),
+        "durationSeconds": duration,
+        "resolvedTopK": 5,
+        "usage": {
+            "inputTokens": usage.input_tokens,
+            "outputTokens": usage.output_tokens,
+            "embeddingTokens": usage.embedding_tokens,
+            "agentInputTokens": usage.agent_input_tokens,
+            "agentOutputTokens": usage.agent_output_tokens,
+            "searchInputTokens": usage.search_input_tokens,
+            "searchOutputTokens": usage.search_output_tokens,
+        },
+        "references": response.body.get("references").cloned().unwrap_or_else(|| json!([])),
+        "trace": response.body.get("events").cloned().unwrap_or_else(|| json!([])),
+    }))
+}
+
+fn remove_benchmark_path(path: &Path) -> Result<(), String> {
+    if !path.exists() {
+        return Ok(());
+    }
+    if path.is_dir() {
+        fs::remove_dir_all(path)
+    } else {
+        fs::remove_file(path)
+    }
+    .map_err(|error| format!("Failed to remove {}: {error}", path.display()))
+}
+
+fn handle_benchmark_delete(app: &AppHandle, run_id: &str) -> ApiResponse {
+    let run = match benchmark_run(run_id) {
+        Ok(run) => run,
+        Err(response) => return response,
+    };
+    let project_root = PathBuf::from(&run.project.path);
+    if !project_root.is_absolute() || project_root.parent().is_none() {
+        return err(409, "Dedicated project path is not safe for cleanup");
+    }
+    let project_record = project_root.join(".llm-wiki").join("project.json");
+    let record = match fs::read(&project_record) {
+        Ok(record) => record,
+        Err(error) => return err(409, format!("Dedicated project record is unavailable: {error}")),
+    };
+    if read_project_id(&run.project.path).as_deref() != Some(run.project.id.as_str()) {
+        return err(409, "Dedicated project identity changed; refusing cleanup");
+    }
+
+    let started = Instant::now();
+    let frontend = benchmark::dispatch_frontend(
+        app,
+        "delete",
+        json!({ "runId": run.id.clone(), "projectPath": run.project.path.clone() }),
+        Duration::from_secs(30),
+    );
+    if let Err(error) = frontend {
+        return err(500, error);
+    }
+    let cleanup_paths = vec![
+        "wiki".to_string(),
+        "media".to_string(),
+        "raw/parsed".to_string(),
+        format!("raw/sources/.benchmark-{}", run.id),
+    ];
+    for relative in cleanup_paths {
+        if let Err(error) = remove_benchmark_path(&project_root.join(relative)) {
+            return err(500, error);
+        }
+    }
+    let metadata = project_root.join(".llm-wiki");
+    if let Err(error) = remove_benchmark_path(&metadata) {
+        return err(500, error);
+    }
+    if let Err(error) = fs::create_dir_all(&metadata)
+        .and_then(|_| fs::write(metadata.join("project.json"), record))
+    {
+        return err(500, format!("Failed to restore dedicated project identity: {error}"));
+    }
+    if let Ok(mut runs) = benchmark_runs().lock() {
+        runs.remove(run_id);
+    } else {
+        return err(500, "Benchmark run registry is unavailable");
+    }
+    ok(json!({
+        "status": "completed",
+        "durationSeconds": started.elapsed().as_secs_f64(),
+        "usage": { "inputTokens": 0, "outputTokens": 0, "embeddingTokens": 0 },
+    }))
+}

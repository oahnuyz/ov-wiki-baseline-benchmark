+  const state = useWikiStore.getState()
+  const llm = { ...state.llmConfig, apiKey: config.arkApiKey }
+  state.setLlmConfig(llm)
+  state.setGlobalLlmConfig(llm)
+  state.setEmbeddingConfig({ ...state.embeddingConfig, apiKey: config.arkApiKey })

+}
+
+async function ingestRun(payload: Record<string, unknown>) {
+  const project = requireActiveProject(payload.projectPath)
+  const runId = String(payload.runId ?? "")
+  const documents = payload.documents
+  if (!runId || !Array.isArray(documents) || documents.length === 0) {
+    throw new Error("Benchmark ingest requires runId and at least one document")
+  }
+
+  const stagingDir = `${normalizePath(project.path)}/raw/sources/.benchmark-${runId}`
+  await createDirectory(stagingDir)
+  const staged: Array<{ sourcePath: string; folderContext: string }> = []
+  for (const [index, source] of documents.entries()) {
+    if (typeof source !== "string" || !source.trim()) {
+      throw new Error(`Invalid benchmark document at index ${index}`)
+    }
+    const name = getFileName(normalizePath(source))
+    if (!name) throw new Error(`Benchmark document has no file name: ${source}`)
+    const destination = `${stagingDir}/${String(index).padStart(5, "0")}-${name}`
+    await copyFile(source, destination)
+    staged.push({ sourcePath: destination, folderContext: "" })
+  }
+
+  const stage = `ingest:${runId}`
+  await invoke("benchmark_telemetry_begin", { stage })
+  beginBenchmarkLlmTelemetry()
+  const started = performance.now()
+  let sweepCompleted = false
+  let operationError: unknown
+  try {
+    await enqueueBatchAndWaitForSweep(project.id, staged)
+    sweepCompleted = true
+  } catch (error) {
+    operationError = error
+  }
+  const durationSeconds = (performance.now() - started) / 1000
+  const llmUsage = finishBenchmarkLlmTelemetry()
+  const rustUsage = await invoke<RustUsage>("benchmark_telemetry_finish", { stage })
+  if (operationError) throw operationError
+  if (!llmUsage.complete || !rustUsage.complete) {
+    throw new Error("Provider usage telemetry was incomplete during ingestion")
+  }
+  return {
+    status: "completed",
+    durationSeconds,
+    usage: {
+      inputTokens: llmUsage.inputTokens + rustUsage.inputTokens,
+      outputTokens: llmUsage.outputTokens + rustUsage.outputTokens,
+      embeddingTokens: rustUsage.embeddingTokens,
+    },
+    reviewSweepCompleted: sweepCompleted,
+    embeddingDimensions: 1024,
+  }
+}
+
+async function execute(request: BridgeRequest): Promise<unknown> {
+  if (request.operation === "create") return configureRun(request.payload)
+  if (request.operation === "ingest") return ingestRun(request.payload)
+  if (request.operation === "delete") {
+    requireActiveProject(request.payload.projectPath)
+    clearQueueState()
+    useReviewStore.getState().setItems([])
+    useLintStore.getState().setItems([])
+    return { cleared: true }
+  }
+  throw new Error(`Unsupported benchmark bridge operation: ${request.operation}`)
+}
+
+export async function installBenchmarkBridge(): Promise<UnlistenFn> {
+  const unlisten = await listen<BridgeRequest>("llm-wiki://benchmark-request", async ({ payload }) => {
+    try {
+      const result = await execute(payload)
+      await invoke("benchmark_bridge_complete", {
+        requestId: payload.requestId,
+        result,
+        error: null,
+      })
+    } catch (error) {
+      await invoke("benchmark_bridge_complete", {
+        requestId: payload.requestId,
+        result: null,
+        error: error instanceof Error ? error.message : String(error),
+      })
+    }
+  })
+  await invoke("benchmark_bridge_listener_ready")
+  return unlisten
+}

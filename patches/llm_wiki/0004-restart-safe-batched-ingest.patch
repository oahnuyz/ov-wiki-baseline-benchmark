+  }
+  for (const [relative, expected] of Object.entries(requiredDefaults)) {
+    const actual = await readFile(`${pp}/${relative}`)
+    if (actual !== expected) {
+      throw new Error(`Continued benchmark project changed protected scaffold file: ${relative}`)
+    }
+  }
+  const structuralFiles = [
+    ...Object.keys(requiredDefaults),
+    "wiki/index.md",
+    "wiki/log.md",
+  ]
+  const hashes = Object.fromEntries(
+    await Promise.all(
+      structuralFiles.map(async (relative) => [
+        relative,
+        await sha256Text(await readFile(`${pp}/${relative}`)),
+      ]),
+    ),
+  )
+  return {
+    template: "general",
+    outputLanguage: "auto",
+    chunking: "official_default",
+    persistExtractedMarkdown: false,
+    continued: true,
+    fileSha256: hashes,
+  }
